---
import { experiences } from "../data/experience";
---

<section id="experience" class="py-12 sm:py-16 lg:py-20 px-6">
  <div class="max-w-4xl mx-auto space-y-16">
    <!-- Section header -->
    <div class="space-y-4">
      <p
        class="text-sm font-mono tracking-widest uppercase"
        style="color: var(--color-accent);"
      >
        02 &mdash; Experience
      </p>
      <h2 class="text-3xl sm:text-4xl font-bold">Where I've Worked</h2>
    </div>

    <!-- Vertical timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div
        class="absolute left-4 sm:left-6 top-0 bottom-0 w-px"
        style="background: linear-gradient(to bottom, var(--color-accent), var(--color-border) 80%);"
      />

      <div class="space-y-10">
        {
          experiences.map((exp) => (
            <div class="relative pl-12 sm:pl-16 group">
              {/* Timeline dot */}
              <div
                class="absolute left-2.5 sm:left-4.5 top-1 w-3 h-3 rounded-full border-2 transition-all duration-300 z-10"
                style={`border-color: ${exp.current ? "var(--color-accent)" : "var(--color-border)"}; background: ${exp.current ? "var(--color-accent)" : "var(--color-bg)"};`}
              />

              {/* Glow ring for current */}
              {exp.current && (
                <div
                  class="absolute left-[7px] sm:left-[13px] top-[1px] w-[18px] h-[18px] rounded-full animate-pulse"
                  style="background: var(--color-accent-glow-strong);"
                />
              )}

              {/* Company card */}
              <div
                class="rounded-2xl border p-6 transition-all duration-300"
                style={`background: var(--color-surface); border-color: ${exp.current ? "rgba(57, 255, 20, 0.3)" : "var(--color-border)"};`}
                onmouseover="this.style.borderColor='var(--color-accent)';this.style.boxShadow='0 0 30px var(--color-accent-glow)'"
                onmouseout={`this.style.borderColor='${exp.current ? "rgba(57, 255, 20, 0.3)" : "var(--color-border)"}';this.style.boxShadow='none'`}
              >
                {/* Header */}
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
                  <div>
                    <h3 class="text-lg font-bold">{exp.role}</h3>
                    <p class="text-sm font-medium" style="color: var(--color-accent);">
                      {exp.company}
                    </p>
                  </div>
                  <span
                    class="inline-flex items-center gap-1.5 px-3 py-1 text-[11px] font-mono rounded-full self-start"
                    style={`background: ${exp.current ? "var(--color-accent-glow)" : "rgba(255,255,255,0.05)"}; color: ${exp.current ? "var(--color-accent)" : "var(--color-text-muted)"}; border: 1px solid ${exp.current ? "rgba(57, 255, 20, 0.2)" : "var(--color-border)"};`}
                  >
                    {exp.current && (
                      <span class="w-1.5 h-1.5 rounded-full" style="background: var(--color-accent);" />
                    )}
                    {exp.period}
                  </span>
                </div>

                {/* Highlights */}
                <ul class="space-y-2.5">
                  {exp.highlights.map((point) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed" style="color: var(--color-text-muted);">
                      <span class="mt-1.5 w-1.5 h-1.5 rounded-full flex-shrink-0" style="background: var(--color-accent);" />
                      {point}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
